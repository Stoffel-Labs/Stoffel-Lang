builtin object ClientStore:
  def take_share(client_id: int64, share_id: int64) -> secret int64 {.builtin.}:
  def take_share_fixed(client_id: int64, share_id: int64) -> secret float {.builtin.}:
  def get_number_clients() -> int64 {.builtin.}:

builtin object MpcOutput:
  def send_to_client(client_id: int64, value: secret unknown) -> bool {.builtin.}:

builtin object Share:
  def from_clear(value: unknown) -> Share {.builtin.}:
  def from_clear_int(value: unknown, bit_length: int64) -> Share {.builtin.}:
  def from_clear_fixed(value: unknown, total_bits: int64, frac_bits: int64) -> Share {.builtin.}:
  def add(share1: unknown, share2: unknown) -> Share {.builtin.}:
  def sub(share1: unknown, share2: unknown) -> Share {.builtin.}:
  def neg(share: unknown) -> Share {.builtin.}:
  def add_scalar(share: unknown, scalar: int64) -> Share {.builtin.}:
  def mul_scalar(share: unknown, scalar: int64) -> Share {.builtin.}:
  def mul(share1: unknown, share2: unknown) -> Share {.builtin.}:
  def open(share: unknown) -> int64 {.builtin.}:
  def send_to_client(share: unknown, client_id: int64) -> bool {.builtin.}:
  def interpolate_local(shares: List[unknown]) -> int64 {.builtin.}:
  def get_type(share: unknown) -> string {.builtin.}:
  def get_party_id(share: unknown) -> int64 {.builtin.}:
  def batch_open(shares: List[unknown]) -> List[unknown] {.builtin.}:
  def open_exp(share: unknown, curve_name: string) -> bytes {.builtin.}:
  def random() -> Share {.builtin.}:
  def get_commitment(share: unknown, index: int64) -> bytes {.builtin.}:
  def commitment_count(share: unknown) -> int64 {.builtin.}:
  def has_commitments(share: unknown) -> bool {.builtin.}:
  def mul_field(share: unknown, field_bytes: bytes) -> Share {.builtin.}:
  def open_field(share: unknown) -> bytes {.builtin.}:
  def open_exp_custom(share: unknown, generator_bytes: bytes) -> bytes {.builtin.}:

builtin object Mpc:
  def party_id() -> int64 {.builtin.}:
  def n_parties() -> int64 {.builtin.}:
  def threshold() -> int64 {.builtin.}:
  def is_ready() -> bool {.builtin.}:
  def instance_id() -> int64 {.builtin.}:
  def rand() -> bytes {.builtin.}:
  def rand_int(bit_length: int64) -> uint64 {.builtin.}:
