def normalize_score(raw_score: Share) -> Share:
  var adjusted = Share.add_scalar(raw_score, 25)
  adjusted = Share.add_scalar(adjusted, 25)
  return Share.mul_scalar(adjusted, 2)

def main() -> int64:
  var client_count = ClientStore.get_number_clients()
  var income_score = ClientStore.take_share(0, 0)

  var eligibility = normalize_score(income_score)

  if client_count > 1:
    var coapplicant_score = ClientStore.take_share(1, 0)
    eligibility = Share.add(eligibility, coapplicant_score)

  var client_outputs: List[Share] = []
  discard array_push(client_outputs, eligibility)

  if Mpc.has_capability("client-output"):
    discard MpcOutput.send_to_client(0, client_outputs)
    if client_count > 1:
      discard Share.send_to_client(eligibility, 1)

  return client_count
