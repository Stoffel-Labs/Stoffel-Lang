def mark_complete() -> void:
  var message = "workflow item completed"
  print(message)
  return

def add_event(events: List[unknown], event_name: string):
  discard array_push(events, event_name)
  return

def main() -> int64:
  var work_item = create_object()
  set_field(work_item, "id", "invoice-2048")
  set_field(work_item, "priority", 7)
  set_field(work_item, "owner", "risk-ops")

  var events = create_array()
  discard array_push(events, "created")
  add_event(events, "scored")
  discard push(events, "approved")
  set_field(work_item, "events", events)

  var labels: List[string] = ["finance", "priority"]
  labels[0] = "billing"

  discard get_field(work_item, "owner")
  discard type(work_item)
  discard type(labels)

  var callback = create_closure("mark_complete")
  discard call_closure(callback)

  return array_length(events) + length(events) + len(events) + labels.len()
