type PartyCount = int64
type ShareBytes = bytes

object MpcJob:
  id: string
  parties: PartyCount
  threshold: int64
  curve: string

object ClientContribution:
  share: secret int64
  client_id: string
  commitments: List[ShareBytes]

object AuditedJob(MpcJob):
  transcript_hash: bytes
  approved: bool

def main() -> int64:
  var job = create_object()
  set_field(job, "id", "nightly-risk-score")
  set_field(job, "parties", 5)
  set_field(job, "threshold", 1)
  set_field(job, "curve", "bls12-381")

  var commitments: List[ShareBytes] = []
  discard commitments.append(Bytes.from_string("commitment-a"))
  discard commitments.append(Bytes.from_string("commitment-b"))
  var review_grid: List[List[int64]] = [[5, 5], [3, 2]]
  var keyed_scores: Dict[string, List[int64]] = {"latency": [1, 2], "privacy": [3, 4]}

  var audit = create_object()
  var approved: bool = true
  set_field(audit, "transcript_hash", Crypto.sha256(Bytes.from_string("nightly-risk-score:v1")))
  set_field(audit, "approved", approved)

  var quorum_score: int64 = get_field(job, "parties") - get_field(job, "threshold")
  quorum_score += commitments.len()
  quorum_score += review_grid[0][1]
  quorum_score += keyed_scores["privacy"][0]

  if approved:
    quorum_score += 10

  print("mpc job schemas loaded")
  return quorum_score
